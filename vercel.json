{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "privacy.html", "use": "@vercel/static" },
    { "src": "terms.html", "use": "@vercel/static" },
    { "src": "contact.html", "use": "@vercel/static" },
    { "src": "about.html", "use": "@vercel/static" },
    { "src": "methodology.html", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "og-image.svg", "use": "@vercel/static" },
    { "src": "ads.txt", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "world-data.js", "use": "@vercel/static" },
    { "src": "satellite.min.js", "use": "@vercel/static" },
    { "src": "hls.light.min.js", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node", "config": { "includeFiles": ["world-data.js", "lib/**"] } }
  ],
  "routes": [
    { "src": "/sitemap.xml", "dest": "/api/pages.js?t=sitemap" },
    { "src": "/countries", "dest": "/api/pages.js?t=countries" },
    { "src": "/country/([^/]+)", "dest": "/api/pages.js?t=country&slug=$1" },
    { "src": "/events", "dest": "/api/pages.js?t=events" },
    { "src": "/event/([^/]+)(?:/[^/]*)?", "dest": "/api/pages.js?t=event&id=$1" },
    { "src": "/guides", "dest": "/api/pages.js?t=guides" },
    { "src": "/guides/([^/]+)", "dest": "/api/pages.js?t=guide&slug=$1" },
    { "src": "/api/fetch", "dest": "/api/fetch.js" },
    { "src": "/contact", "dest": "contact.html" },
    { "src": "/about", "dest": "about.html" },
    { "src": "/methodology", "dest": "methodology.html" },
    { "src": "/privacy", "dest": "privacy.html" },
    { "src": "/terms", "dest": "terms.html" },
    { "src": "/api/live", "dest": "/api/live.js" },
    { "src": "/api/ingest", "dest": "/api/ingest.js" },
    { "src": "/api/events", "dest": "/api/events.js" },
    { "src": "/api/subscribe", "dest": "/api/subscribe.js" },
    { "src": "/api/firms", "dest": "/api/firms.js" },
    { "src": "/api/flights", "dest": "/api/flights.js" },
    { "src": "/api/webcams", "dest": "/api/webcams.js" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/og-image.svg", "dest": "/og-image.svg" },
    { "src": "/sw.js", "dest": "/sw.js", "headers": { "Cache-Control": "no-cache", "Service-Worker-Allowed": "/" } },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" }
  ]
}
